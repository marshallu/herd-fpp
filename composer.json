{
	"name": "marshallu/herd-fpp",
	"description": "Focal point picker for WordPress images.",
	"keywords": ["wordpress", "plugin", "focal point", "media"],
	"homepage": "https://github.com/marshallu/herd-fpp",
	"license": "MIT",
	"authors": [
		{
			"name": "Christopher McComas"
		}
	],
	"type": "wordpress-plugin",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.13",
		"wp-coding-standards/wpcs": "^3.1",
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^6.9",
		"php-stubs/wp-cli-stubs": "^2.12",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"wp-phpunit/wp-phpunit": "^7.1",
		"yoast/phpunit-polyfills": "^3.0 || ^4.0",
		"phpunit/phpunit": "^9.6",
		"roots/wordpress-full": "^7.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.2.0"
		}
	},
	"scripts": {
		"format": "phpcbf --extensions=php --standard=phpcs.xml.dist --report-summary --report-source",
		"lint": "phpcs --extensions=php --standard=phpcs.xml.dist",
		"analyse": "phpstan analyse --configuration=phpstan.neon --memory-limit=2G",
		"test": "phpunit"
	}
}
