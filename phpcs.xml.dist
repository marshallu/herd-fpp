<?xml version="1.0"?>
<ruleset name="Herd Focal Point Picker">
	<description>WordPress and VIP coding standards for Herd Focal Point Picker.</description>

	<rule ref="WordPress">
		<exclude name="WordPress.PHP.YodaConditions"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<exclude name="WordPress.WP.GlobalVariablesOverride"/>
	</rule>

	<rule ref="WordPress-VIP-Go"/>

	<file>.</file>
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>
	<exclude-pattern>phpstan-bootstrap.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>

	<config name="minimum_wp_version" value="6.5"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="herd-fpp"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="herd_fpp"/>
				<element value="HERD_FPP"/>
				<element value="Herd_FPP"/>
			</property>
		</properties>
	</rule>
</ruleset>
